<mxfile host="app.diagrams.net"><diagram name="Data model" id="d1"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Experiment&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+ id: int&lt;br&gt;+ createdAt, startedAt, completedAt: datetime&lt;br&gt;+ approach: {collaboration, coordination,&lt;br&gt;&amp;nbsp;&amp;nbsp;consensus, mdl_federation, centralized}&lt;br&gt;+ dataset: str&lt;br&gt;+ numberOfClients: int&lt;br&gt;+ partitionStrategy: {iid, non_iid}&lt;br&gt;+ learner: {popper, andante, mdl, ...}&lt;br&gt;+ randomSeed: int&lt;br&gt;+ rounds: int&lt;br&gt;+ timeout: float&lt;br&gt;+ serverAddress: str&lt;br&gt;+ status: str&lt;br&gt;+ errorMessage: str' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="200" width="300" height="254" as="geometry"/></mxCell><mxCell id="c3" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Benchmark&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+ id: int&lt;br&gt;+ name: str&lt;br&gt;+ approach, dataset: str&lt;br&gt;+ numberOfClients: int&lt;br&gt;+ partitionStrategy: str&lt;br&gt;+ numberOfRuns: int&lt;br&gt;+ baseSeed: int&lt;br&gt;+ learner: str&lt;br&gt;+ rounds, timeout: int&lt;br&gt;+ status: str&lt;br&gt;+ createdAt, completedAt: datetime' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="250" height="206" as="geometry"/></mxCell><mxCell id="c4" value='&lt;div style="text-align:center"&gt;&lt;b&gt;BenchmarkRun&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;+ runNumber: int&lt;br&gt;+ randomSeed: int' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;sp