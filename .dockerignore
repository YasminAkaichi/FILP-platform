# Local dev environment — never needed inside the image, and huge.
.venv/
venv/
env/
__pycache__/
*.pyc
.pytest_cache/

# Git metadata
.git/
.gitignore

# Local secrets — pass these in at runtime instead (see docker-compose.yml).
.streamlit/secrets.toml

# Local runtime data — regenerated by the app; don't bake stale copies in.
data/*.db
data/*.sqlite
data/*.sqlite3
experiments.db
artifacts/
datasets/generated/

# Editor / OS cruft
.DS_Store
.vscode/
.idea/

# Not needed at runtime
README.md
*.tex
.pytest_cache/
tests/
test_*.py
